{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RA Realm Launcher",
  "version": "0.1.0",
  "identifier": "app.rarealm.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RA Realm Launcher",
        "width": 1080,
        "height": 700,
        "resizable": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
